# Server-side only (set in Vercel project env). Never prefix with VITE_.
# Without GEMINI_API_KEY the Care Brief is composed deterministically from the records.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Without RESEND_API_KEY reminder emails are composed and logged as "not sent".
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email).
EMAIL_FROM=CareCircle <onboarding@resend.dev>
