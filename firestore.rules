rules_version = '2';

// CareCircle access model
// - Everything about a patient lives under /circles/{circleId}.
// - Only members of a circle can read it. Membership is a doc at members/{uid}.
// - You become a member only by (a) creating the circle, or (b) presenting one of its invite codes:
//     secret/join      = Family code: may join as patient, family or caregiver. Readable by patient/family only.
//     secret/caregiver = Caregiver code: may join ONLY as caregiver. Readable by every member.
//   The code a joiner types is written to a private join proof (joins/{uid}) that nobody can read,
//   so it is never stored where other members could see it.
// - Patient and family edit the care plan (medications, profile, passcode).
//   Every member can record doses, add appointments and write care notes.
//   Notes and activity are append-only so the shared timeline cannot be rewritten.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function circlePath(c) { return /databases/$(db)/documents/circles/$(c); }
    function memberPath(c) { return /databases/$(db)/documents/circles/$(c)/members/$(request.auth.uid); }
    function isMember(c) { return signedIn() && exists(memberPath(c)); }
    function myRole(c) { return get(memberPath(c)).data.role; }
    function canEditPlan(c) { return isMember(c) && myRole(c) in ['patient', 'family']; }
    // Write-side variants. In a batched write, exists()/get() see the database BEFORE the batch,
    // so a circle's creator would not yet count as a member for the circle's first records.
    // existsAfter()/getAfter() see the batch's result. Membership itself is still gated below
    // (creator or correct passcode), so this does not let anyone in.
    function isMemberW(c) { return signedIn() && existsAfter(memberPath(c)); }
    function canEditPlanW(c) { return isMemberW(c) && getAfter(memberPath(c)).data.role in ['patient', 'family']; }
    function validRole(r) { return r in ['patient', 'family', 'caregiver']; }
    // The writer's own membership as it will be after this write (name and role are what records show).
    function meW(c) { return getAfter(memberPath(c)).data; }
    // Sample history in a demo circle is written by its creator on behalf of fictional people.
    function isDemoW(c) { return getAfter(circlePath(c)).data.demo == true; }
    // Records must carry the writer's real name and role (no labelling a dose or note as someone else).
    function signedAs(c, nameField, roleField) {
      return isDemoW(c) || (request.resource.data[nameField] == meW(c).name && request.resource.data[roleField] == meW(c).role);
    }
    function secretPath(c, which) { return /databases/$(db)/documents/circles/$(c)/secret/$(which); }
    function validCode(v) { return v is string && v.size() >= 8; }
    // The code in the joiner's private proof must match the Family code (any role) or the Caregiver code (caregiver only).
    function joinedWithCode(c, uid, role) {
      let code = getAfter(/databases/$(db)/documents/circles/$(c)/joins/$(uid)).data.code;
      return code == get(secretPath(c, 'join')).data.passcode
        || (role == 'caregiver' && exists(secretPath(c, 'caregiver')) && code == get(secretPath(c, 'caregiver')).data.passcode);
    }
    function isNow(t) { return t is int && t > request.time.toMillis() - 300000 && t < request.time.toMillis() + 300000; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /circles/{c} {
      allow read: if isMember(c);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // createdBy and the demo flag are fixed at creation (a real patient can never be relabelled as sample data).
      allow update: if canEditPlanW(c)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('demo', false) == resource.data.get('demo', false);
      allow delete: if false;

      match /secret/{doc} {
        // Caregivers may see (and pass on) only the Caregiver code, never the Family code.
        allow read: if doc == 'caregiver' ? isMember(c) : canEditPlan(c);
        allow create: if doc in ['join', 'caregiver'] && validCode(request.resource.data.passcode)
          && (getAfter(circlePath(c)).data.createdBy == request.auth.uid || canEditPlanW(c));
        allow update: if canEditPlanW(c) && validCode(request.resource.data.passcode);
        allow delete: if false;
      }

      // Private join proofs: written by the joiner, read by nobody (only the rules look inside).
      match /joins/{uid} {
        allow read: if false;
        allow create, update: if signedIn() && uid == request.auth.uid && request.resource.data.code is string;
        allow delete: if false;
      }

      match /members/{uid} {
        allow read: if isMember(c);
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == uid
          && validRole(request.resource.data.role)
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          // The email that reminders go to must be the member's own sign-in email.
          && request.resource.data.email == request.auth.token.email
          // No invite code is ever stored in the member record (other members can read it).
          && !('passcode' in request.resource.data)
          && (
            getAfter(circlePath(c)).data.createdBy == request.auth.uid
            || joinedWithCode(c, uid, request.resource.data.role)
          );
        // Members may change only their own display name: never their role, uid or email.
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0;
        allow delete: if signedIn() && (uid == request.auth.uid || canEditPlanW(c));
      }

      match /medications/{id} {
        allow read: if isMember(c);
        allow create, update: if canEditPlanW(c)
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.times is list && request.resource.data.times.size() > 0;
        allow delete: if canEditPlanW(c);
      }

      match /appointments/{id} {
        allow read: if isMember(c);
        allow create: if isMemberW(c) && request.resource.data.title is string && request.resource.data.date is string
          && (isDemoW(c) || request.resource.data.createdByName == meW(c).name);
        allow update: if isMemberW(c) && request.resource.data.title is string && request.resource.data.date is string
          && request.resource.data.createdByName == resource.data.createdByName;
        allow delete: if isMemberW(c);
      }

      match /doseLogs/{id} {
        allow read: if isMember(c);
        allow create, update: if isMemberW(c)
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.status in ['taken', 'skipped']
          && signedAs(c, 'byName', 'byRole')
          && (isNow(request.resource.data.at) || isDemoW(c));
        allow delete: if isMemberW(c);
      }

      match /notes/{id} {
        allow read: if isMember(c);
        allow create: if isMemberW(c)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.kind in ['note', 'handover']
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && signedAs(c, 'authorName', 'authorRole')
          // No back-dating, except sample history written while creating a demo circle.
          && (isNow(request.resource.data.at) || isDemoW(c));
        allow update, delete: if false;
      }

      match /activity/{id} {
        allow read: if isMember(c);
        allow create: if isMemberW(c) && isNow(request.resource.data.at) && signedAs(c, 'byName', 'byRole');
        allow update, delete: if false;
      }

      // Notification records double as a lock: the first member to create the record for a
      // given event sends the email; later attempts fail the create and do nothing.
      match /notifications/{id} {
        allow read: if isMember(c);
        allow create: if isMemberW(c) && request.resource.data.status == 'pending';
        allow update: if isMemberW(c) && request.resource.data.kind == resource.data.kind && (
          // Re-claim an unsent record for a retry (the app enforces the 10-minute cooldown).
          (resource.data.status != 'sent' && request.resource.data.status == 'pending' && isNow(request.resource.data.at))
          // Settle a pending record once, changing only its status and detail. "sent" is final.
          || (resource.data.status == 'pending'
              && request.resource.data.status in ['sent', 'failed', 'not-configured']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'detail']))
        );
        allow delete: if false;
      }
    }
  }
}
